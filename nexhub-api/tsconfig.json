{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node",
    "rootDir": "src", "outDir": "dist", "strict": true,
    "esModuleInterop": true, "skipLibCheck": true, "sourceMap": true, "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"]
}
